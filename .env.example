# ---------------------------------------------------------------------------
# PetPals — environment variables
# Copy this file to `.env` and fill in your own values.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# ---------------------------------------------------------------------------

# Turso (libSQL) database — create one free at https://turso.tech
#   1. Databases -> Create database (pick a name + a region near your visitors)
#   2. Copy the URL (looks like libsql://your-database-xxxx.turso.io)
VITE_TURSO_DB_URL=libsql://your-database-name.turso.io

#   3. Open the database -> Generate token -> copy it (looks like eyJ...)
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token
